# CaseSifter local secrets — copy values into `.env` at the repo root (never commit real keys).

# Track B — gotcha logic verifier (Claude when key present; does NOT invent free-form lies)
# auto = Claude if ANTHROPIC_API_KEY set, else Gemini. Candidates are proposed first;
# hard vetoes + four gates (same fact / against / material / quotes) contain noise.
# Gemini remains the multimodal exhibit forensics engine (Track C below).
GOTCHA_VERIFY_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=
# OPENAI_VERIFY_MODEL=gpt-4.1

# Track C — historical impossibility / multimodal exhibit forensics (required for AI lanes)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CONTEXTUAL_MULTIMODAL=true
# Practice pack: foreclosure | insurance | malpractice
PRACTICE_PACK=foreclosure
# Extra Gemini vision pass for logo/chrome on bank/utility statements (wrong-era mark, crispness).
# Default on — strongest scan-survivable lane for fabricated consumer bills.
LOGO_CHROME_PASS=true

# Hybrid
EPHEMERAL_JOBS=true
ENTITLEMENT_MODE=open

# Optional scrubbed crash reporting (analysis API)
# Set the real project DSN on Render / host env — do not commit it.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Frontend / Electron UI (Vite): set in frontend/.env for local, or at pack time:
#   VITE_SENTRY_DSN=   (prepare-ui / GitHub Actions secrets.VITE_SENTRY_DSN)
#   CASESIFTER_SENTRY_DSN=  (Electron main; often same project DSN)
# Same project DSN is fine; UI events get tag service=casesifter-ui

# Scan watchdog (running jobs)
# SCAN_STALL_SECONDS=420   # fail if no progress for 7 minutes
# SCAN_MAX_SECONDS=1080    # fail if running longer than 18 minutes
