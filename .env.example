# CaseSifter local secrets — copy values into `.env` at the repo root (never commit real keys).

# Track B — gotcha logic verifier (Claude when key present; does NOT invent free-form lies)
# auto = Claude if ANTHROPIC_API_KEY set, else Gemini. Candidates are proposed first;
# hard vetoes + four gates (same fact / against / material / quotes) contain noise.
# Gemini remains the multimodal exhibit forensics engine (Track C below).
GOTCHA_VERIFY_PROVIDER=auto
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# OPENAI_API_KEY=
# OPENAI_VERIFY_MODEL=gpt-4.1

# Track C — historical impossibility / multimodal exhibit forensics (required for AI lanes)
GEMINI_API_KEY=
# Per-task models (do not use gemini-2.0-flash — shutdown 2026-06-01).
TASK_A_EXTRACT_PRIMARY=gemini-3.6-flash
TASK_A_EXTRACT_BACKUP=gemini-3.5-flash-lite
TASK_A_EXTRACT_THINKING_LEVEL=minimal
TASK_B_ENTITY_PRIMARY=gemini-3.8-flash
TASK_B_ENTITY_BACKUP=gemini-3.6-flash
TASK_B_ENTITY_THINKING_LEVEL=medium
TASK_C_CONTRA_PRIMARY=gemini-3.8-flash
TASK_C_CONTRA_BACKUP=gemini-3.6-flash
TASK_C_CONTRA_THINKING_LEVEL=high
TASK_D_VISUAL_PRIMARY=gemini-3.8-flash
TASK_D_VISUAL_BACKUP=gemini-3.6-flash
TASK_D_VISUAL_THINKING_LEVEL=medium
# generateContent accepts service_tier (REST GenerateContentRequest.serviceTier).
# Applied to Task A only (standard|priority|flex). Monitor x-gemini-service-tier for downgrades.
GEMINI_SERVICE_TIER=standard
# Keep at 2 while Google capacity 503s are elevated (do not set 3+).
GEMINI_MAX_CONCURRENT=2
CONTEXTUAL_MULTIMODAL=true
# Practice pack: foreclosure | insurance | malpractice
PRACTICE_PACK=foreclosure
# Extra Gemini vision pass for logo/chrome on bank/utility statements (wrong-era mark, crispness).
# Default on — strongest scan-survivable lane for fabricated consumer bills.
LOGO_CHROME_PASS=true

# Hybrid
EPHEMERAL_JOBS=true
ENTITLEMENT_MODE=open
# Transport / cookies (see docs/security-tls.md). There is no TLS 2.0 —
# production edges must offer TLS 1.2+ (prefer 1.3). HSTS is emitted on HTTPS.
# APP_ENV=production
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
# FORCE_HSTS=true   # only behind a local HTTPS proxy when testing HSTS
# Hosted analysis soft-launch (Render): set APP_MODE=analysis, CORS allow-list (not *),
# CLOUD_CONTROL_URL=https://casesifter-control.onrender.com, ANALYSIS_API_KEYS=…
# Control plane Stripe (secrets on Render only — see docs/STRIPE.md):
#   STRIPE_SECRET_KEY=sk_test_…   STRIPE_WEBHOOK_SECRET=whsec_…
#   STRIPE_PRICE_ID=price_1UMIUnD6sOleRtjBjVbHzMdP   # $79/seat/mo (prod_VN2ZsVDlIiPkHD)
#   No STRIPE_PUBLISHABLE_KEY — hosted Checkout + Customer Portal are server-side.
# Webhook URL: https://casesifter-control.onrender.com/v1/webhooks/stripe
#   (checkout.session.completed, customer.subscription.*, invoice.payment_failed)
# Verify/reset mail (set on casesifter-control; never commit the key):
#   RESEND_API_KEY=re_…  and SMTP_FROM=CaseSifter <noreply@casesifter.com>
#   or SMTP_HOST, SMTP_PORT=587, SMTP_USERNAME, SMTP_PASSWORD, SMTP_FROM, SMTP_USE_TLS=true
# Production signup returns 503 until one of those is set. /health reports "email": true|false.
# CASESIFTER_PUBLIC_URL=https://casesifter-app.onrender.com (until app.casesifter.com DNS),
# CASESIFTER_INVITE_REQUIRED=false, CASESIFTER_INVITE_CODES=…
# Frontend build (frontend/.env or Render casesifter-app): VITE_CONTROL_PLANE_URL, VITE_ANALYSIS_API_URL

# Optional scrubbed crash reporting (analysis API)
# Set the real project DSN on Render / host env — do not commit it.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Frontend / Electron UI (Vite): set in frontend/.env for local, or at pack time:
#   VITE_SENTRY_DSN=   (prepare-ui / GitHub Actions secrets.VITE_SENTRY_DSN)
#   CASESIFTER_SENTRY_DSN=  (Electron main; often same project DSN)
# Same project DSN is fine; UI events get tag service=casesifter-ui

# Scan watchdog (running jobs)
# SCAN_STALL_SECONDS=420   # fail if no progress for 7 minutes
# SCAN_MAX_SECONDS=1080    # fail if running longer than 18 minutes

# ── Admin / SSO / 2FA (control plane — see docs/admin-sso-2fa.md) ─────────────
# SESSION_SECRET=   # required shared secret (control + analysis); already used for cs_session
# TOTP_ENC_KEY=     # optional; Fernet key material for authenticator secrets (else SESSION_SECRET)
# TOTP_ISSUER=CaseSifter
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8001/v1/sso/oidc/callback
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=yourfirm.com
# OIDC_TRUSTS_IDP_MFA=true   # SSO login skips local TOTP when IdP enforces MFA
# CONTROL_ADMIN_TOKEN=       # sales trial grant only (X-Admin-Token); not a 2FA bypass
