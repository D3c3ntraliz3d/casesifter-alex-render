# Frontend (Vite) — copy to frontend/.env for local/dev builds
# Client DSN is expected to ship in the browser bundle.

# Soft-launch hosted control plane + analysis (baked in at build time on Render casesifter-app)
VITE_CONTROL_PLANE_URL=https://casesifter-control.onrender.com
# Leave empty for local Vite proxy to http://127.0.0.1:8000; set for hosted SPA:
# VITE_ANALYSIS_API_URL=https://casesifter-analysis.onrender.com
VITE_ANALYSIS_API_URL=
# Optional ops key (usually unset in browser builds — prefer control-plane session Bearer)
# Do NOT set VITE_ANALYSIS_API_KEY for hosted browser builds — ops keys bypass
# normal session auth and must stay server/desktop-only.
# VITE_ANALYSIS_API_KEY=

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
